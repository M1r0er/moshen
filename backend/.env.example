# 墨参 MoShen 配置文件
# 复制此文件到 ~/.moshen/.env 并填写你的 API Key
# 至少配置一组模型即可使用，系统会自动降级

# ==========================================
# TEXT_MASTER: 文学性分析、文风诊断、文笔评估
# 推荐：文字能力最强的大模型
# ==========================================
TEXT_MASTER_MODEL=claude-sonnet-4-20250514
TEXT_MASTER_BASE_URL=https://api.anthropic.com
TEXT_MASTER_API_KEY=your-api-key-here
TEXT_MASTER_TEMPERATURE=0.7
TEXT_MASTER_MAX_TOKENS=8192

# ==========================================
# STRUCTURE_ANALYST: 大纲结构分析、节奏诊断、逻辑检查
# 推荐：推理能力强的大模型
# ==========================================
STRUCTURE_ANALYST_MODEL=deepseek-chat
STRUCTURE_ANALYST_BASE_URL=https://api.deepseek.com
STRUCTURE_ANALYST_API_KEY=your-api-key-here
STRUCTURE_ANALYST_TEMPERATURE=0.5
STRUCTURE_ANALYST_MAX_TOKENS=8192

# ==========================================
# KNOWLEDGE_BUILDER: 拆书、知识提取、叙事模式抽象（可选功能）
# 推荐：快速模型（成本低、速度快）
# ==========================================
KNOWLEDGE_BUILDER_MODEL=deepseek-chat
KNOWLEDGE_BUILDER_BASE_URL=https://api.deepseek.com
KNOWLEDGE_BUILDER_API_KEY=your-api-key-here
KNOWLEDGE_BUILDER_TEMPERATURE=0.3
KNOWLEDGE_BUILDER_MAX_TOKENS=4096

# ==========================================
# DIALOGUE_PARTNER: 日常对话、创意讨论、问答
# 推荐：均衡模型（质量与速度兼顾）
# ==========================================
DIALOGUE_PARTNER_MODEL=deepseek-chat
DIALOGUE_PARTNER_BASE_URL=https://api.deepseek.com
DIALOGUE_PARTNER_API_KEY=your-api-key-here
DIALOGUE_PARTNER_TEMPERATURE=0.7
DIALOGUE_PARTNER_MAX_TOKENS=8192
